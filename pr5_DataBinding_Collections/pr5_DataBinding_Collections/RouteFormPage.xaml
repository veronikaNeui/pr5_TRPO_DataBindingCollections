<Page x:Class="pr5_DataBinding_Collections.RouteFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr5_DataBinding_Collections"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RouteFormPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поля маршрута -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Content="ID" Grid.Row="0" Grid.Column="0"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="3" Text="{Binding Id}"/>

            <Label Content="Название" Grid.Row="1" Grid.Column="0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="3" Text="{Binding Name}"/>

            <Label Content="Начальная точка" Grid.Row="2" Grid.Column="0"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="3" Text="{Binding StartPoint}"/>

            <Label Content="Конечная точка" Grid.Row="3" Grid.Column="0"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="3" Text="{Binding EndPoint}"/>

            <Label Content="Общая длина, км" Grid.Row="4" Grid.Column="0"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="3" VerticalAlignment="Center"
                       Text="{Binding TotalDistanceKm}"/>
        </Grid>

        <!-- Ввод нового участка -->
        <GroupBox Grid.Row="1" Header="Новый участок" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Label Content="От:" VerticalAlignment="Center"/>
                <TextBox x:Name="SectionFrom" Width="120" Margin="3"/>

                <Label Content="До:" VerticalAlignment="Center"/>
                <TextBox x:Name="SectionTo" Width="120" Margin="3"/>

                <Label Content="Км:" VerticalAlignment="Center"/>
                <TextBox x:Name="SectionKm" Width="80" Margin="3"/>

                <Button Content="Добавить участок" Margin="5" Padding="5"
                        Click="AddSection_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Список участков -->
        <GroupBox Grid.Row="2" Header="Участки маршрута" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" x:Name="SectionsList"
                          ItemsSource="{Binding Sections}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StartPoint}"/>
                                <TextBlock Text=" -> "/>
                                <TextBlock Text="{Binding EndPoint}"/>
                                <TextBlock Text=" ("/>
                                <TextBlock Text="{Binding DistanceKm}"/>
                                <TextBlock Text=" км)"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="1" Content="Удалить участок"
                        HorizontalAlignment="Left" Margin="0,5,0,0" Padding="5"
                        Click="DeleteSection_Click"/>
            </Grid>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Сохранить" Margin="3" Padding="10,5" Click="AddButton_Click"/>
            <Button Content="Назад" Margin="3" Padding="10,5" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
